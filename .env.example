# ===========================================
# SocleTracker - Variables d'environnement
# ===========================================

# Configuration GitLab (optionnel)
VITE_GITLAB_URL=https://gitlab.example.com
VITE_GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Configuration GitHub (optionnel)
VITE_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Configuration OpenAI (optionnel)
VITE_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# Configuration Anthropic (optionnel)
VITE_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Configuration Jira (optionnel)
VITE_JIRA_URL=https://your-company.atlassian.net
VITE_JIRA_EMAIL=admin@company.com
VITE_JIRA_API_TOKEN=xxxxxxxxxxxxxxxxxxxx
VITE_JIRA_PROJECT_KEY=MIGRATION

# Configuration SMTP pour emails (optionnel)
VITE_SMTP_HOST=smtp.example.com
VITE_SMTP_PORT=587
VITE_SMTP_USER=noreply@example.com
VITE_SMTP_PASSWORD=your-password

# Configuration Slack Webhook (optionnel)
VITE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXX

# Configuration Teams Webhook (optionnel)
VITE_TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/xxxxxxxx

# Configuration Prometheus (optionnel)
VITE_PROMETHEUS_URL=http://prometheus:9090

# Configuration Grafana (optionnel)
VITE_GRAFANA_URL=http://grafana:3000

# Mode de l'application
NODE_ENV=production
